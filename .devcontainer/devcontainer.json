{
  // Sets up the Codespace for this repository. Leave this file alone.
  // The image is a small Ubuntu one, because this site needs no build tools: GitHub's full default image took
  // more than three minutes to start on November 18, 2026. Live Preview serves the page; it opens in a browser tab,
  // because its built-in pane showed a broken page in Chrome in the same test.
  "name": "DESN 368 portfolio",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.live-server"],
      "settings": {
        "livePreview.defaultPreviewPath": "/index.html",
        "livePreview.openPreviewTarget": "External Browser"
      }
    }
  }
}
